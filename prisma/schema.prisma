// Schema do NihongoHub.
//
// A conexão vem de `prisma7.config.ts`, que lê DATABASE_URL do `.env`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Como o usuário avaliou a própria lembrança do card.
enum Rating {
  again
  hard
  good
  easy

  @@map("rating")
}

/// O silabário de uma palavra. `null` nos cards que usam kanji.
enum Script {
  hiragana
  katakana

  @@map("script")
}

/// Como o card foi apresentado na revisão.
enum ModoEstudo {
  /// Revela a resposta e a pessoa se auto-avalia.
  flashcard
  /// A pessoa digita o romaji e o app confere.
  digitacao

  @@map("modo_estudo")
}

model Deck {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  /// Quantas palavras ficam em aprendizado ao mesmo tempo. Uma nova só entra
  /// quando outra amadurece — é o que impede o deck de despejar tudo de uma vez.
  loteAtivo   Int      @default(10) @map("lote_ativo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cards   Card[]
  reviews Review[]

  @@map("decks")
}

model Card {
  id             String   @id @default(uuid())
  deckId         String   @map("deck_id")
  /// O que aparece na frente: um kanji, uma palavra ou uma expressão.
  front          String
  /// Leitura em kana.
  reading        String
  /// Significado em português.
  meaning        String
  /// Frase de exemplo — contexto ajuda mais que tradução solta.
  example        String?
  exampleMeaning String?  @map("example_meaning")
  tags           String[] @default([])
  /// Silabário da palavra, para filtrar a sessão. `null` nos cards com kanji.
  script         Script?

  // Estado do SRS, achatado em colunas em vez de um JSON: só assim o
  // vencimento entra em índice, e a fila do dia vira uma varredura de range.
  /// Fator de facilidade do SM-2.
  ease         Float    @default(2.5)
  /// Intervalo atual em dias. 0 enquanto o card não graduou.
  intervalDays Int      @default(0) @map("interval_days")
  repetitions  Int      @default(0)
  /// Índice do passo de aprendizado; null significa card já graduado.
  learningStep Int?     @map("learning_step")
  dueAt        DateTime @map("due_at") @db.Timestamptz(3)
  lapses       Int      @default(0)

  /// Quando a palavra foi estudada pela primeira vez. `null` = nunca vista.
  ///
  /// Nenhuma combinação dos campos de SRS dá esse sinal: um card novo e um
  /// card recém-errado têm exatamente o mesmo estado (`repetitions: 0`,
  /// `learningStep: 0`). Sem esta coluna não há como montar um lote fixo nem
  /// contar corretamente quantas palavras ainda são novidade.
  introducedAt DateTime? @map("introduced_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deck    Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews Review[]

  // A fila de um deck e a fila geral são as duas únicas leituras quentes.
  @@index([deckId, dueAt])
  @@index([dueAt])
  // Montagem do lote: separar o que já foi introduzido do que ainda é novo,
  // opcionalmente filtrando por silabário.
  @@index([deckId, introducedAt])
  @@index([deckId, script, introducedAt])
  @@map("cards")
}

model Review {
  id     Int    @id @default(autoincrement())
  cardId String @map("card_id")
  deckId String @map("deck_id")
  rating Rating
  /// Em que modo o card foi respondido. Um "again" de botão e um "again" por
  /// erro de digitação são eventos diferentes; sem esta coluna eles nascem
  /// indistinguíveis e o passado não é recuperável.
  modo   ModoEstudo @default(flashcard)
  /// O que foi digitado, quando a resposta saiu errada no modo digitação.
  /// É o que permite descobrir depois quais erros se repetem.
  resposta String?
  /// Revisão de treino livre: conta para as estatísticas, mas não mexeu no
  /// agendamento do card. Sem esta marca, o histórico misturaria prática
  /// avulsa com revisão na hora certa e as duas deixariam de ser legíveis.
  treino   Boolean @default(false)

  reviewedAt DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  /// Intervalo antes e depois: permite reconstruir a curva de aprendizado.
  intervalBefore Int @map("interval_before")
  intervalAfter  Int @map("interval_after")
  /// Quanto tempo o card ficou na tela.
  durationMs     Int @map("duration_ms")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([reviewedAt])
  @@index([deckId, reviewedAt])
  @@map("reviews")
}
